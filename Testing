## Contoh Test

### ContextManager

```python
# tests/test_context_manager.py
from aira.core.context_manager import ContextManager
from aira.config.settings import ContextConfig


def test_add_turn_stores_messages():
    """add_turn harus menyimpan user dan assistant message."""
    cm = ContextManager(ContextConfig())
    cm.add_turn(user="halo", assistant="halo Pasha")

    messages = cm.get_messages()
    assert len(messages) == 2
    assert messages[0] == {"role": "user", "content": "halo"}
    assert messages[1] == {"role": "assistant", "content": "halo Pasha"}


def test_get_messages_respects_max_limit():
    """get_messages tidak boleh mengembalikan lebih dari max_messages."""
    cm = ContextManager(ContextConfig(max_messages=4))

    # Tambah 5 giliran (10 pesan)
    for i in range(5):
        cm.add_turn(user=f"pesan {i}", assistant=f"balasan {i}")

    messages = cm.get_messages(max_messages=4)
    assert len(messages) == 4


def test_clear_resets_history():
    """clear() harus menghapus semua history."""
    cm = ContextManager(ContextConfig())
    cm.add_turn(user="halo", assistant="halo")
    cm.clear()

    assert cm.is_empty()
    assert cm.get_messages() == []
```

### Orchestrator (dengan mock)

```python
# tests/test_orchestrator.py
from unittest.mock import MagicMock, patch
from aira.core.orchestrator import Orchestrator
from aira.core.context_manager import ContextManager
from aira.config.settings import AiraConfig, ContextConfig


def make_orchestrator():
    """Factory untuk membuat Orchestrator dengan semua dependency di-mock."""
    mock_stt = MagicMock()
    mock_stt.transcribe.return_value = "halo Aira"

    mock_llm = MagicMock()
    mock_llm.generate.return_value = "halo Pasha"

    mock_tts = MagicMock()

    context = ContextManager(ContextConfig())

    return Orchestrator(
        stt=mock_stt,
        llm=mock_llm,
        tts=mock_tts,
        context=context,
        master_prompt="Kamu adalah Aira.",
        config=AiraConfig(),
    ), mock_stt, mock_llm, mock_tts


def test_process_turn_calls_components_in_order():
    """process_turn harus memanggil STT, LLM, dan TTS secara berurutan."""
    orchestrator, mock_stt, mock_llm, mock_tts = make_orchestrator()

    orchestrator.process_turn("path/to/audio.wav")

    mock_stt.transcribe.assert_called_once_with("path/to/audio.wav")
    mock_llm.generate.assert_called_once()
    mock_tts.speak.assert_called_once_with("halo Pasha")


def test_process_turn_saves_to_context():
    """process_turn harus menyimpan giliran ke ContextManager."""
    orchestrator, _, _, _ = make_orchestrator()

    orchestrator.process_turn("path/to/audio.wav")

    messages = orchestrator._context.get_messages()
    assert any(m["role"] == "user" for m in messages)
    assert any(m["role"] == "assistant" for m in messages)
```

